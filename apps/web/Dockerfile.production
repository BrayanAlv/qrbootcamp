# ========== Etapa build: compila el SPA ==========
FROM node:24-alpine AS build
WORKDIR /app

# VITE_API_URL se inyecta en build (variable en tiempo de construccion).
# En produccion se usa ruta relativa: el nginx sirve la SPA y proxya /api.
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ========== Etapa runtime: nginx sirve estaticos y proixya /api ==========
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80