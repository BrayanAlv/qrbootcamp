{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",

      "*.env.example": "allow",
      "**/.env.example": "allow"
    },

    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",

      "*.env.example": "allow",
      "**/.env.example": "allow"
    },

    "bash": "allow"
  },

  "watcher": {
    "ignore": [
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "node_modules/**",
      ".git/**"
    ]
  },

  "mcp": {
    "filesystem": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "timeout": 30000
    }
  }
}