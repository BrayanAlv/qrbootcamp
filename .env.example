# ============================================================
# Variables de entorno - ejemplo
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas valores reales a control de versiones.
# ============================================================

NODE_ENV=development

# Puerto interno del API (Docker lo expone como 3080 en el host)
PORT=3000

# Conexión a MongoDB (nombre de servicio Docker, no expuesto)
MONGODB_URI=mongodb://mongodb:27017/qr_invitations

# ============================================================
# JWT - firma asimétrica RS256
# Genera el par de llaves con:
#   openssl genrsa -out jwtRS256.key 4096
#   openssl rsa -in jwtRS256.key -pubout -out jwtRS256.key.pub
# Pega el contenido PEM (con saltos de línea \n) en estas variables.
# ============================================================
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

JWT_ISSUER=qr-invitations
JWT_AUDIENCE=qr-invitations-web

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================================
# CORS / frontend
# Dev: web en 5573 y api en 3080 (sin Nginx).
# Prod: usa el dominio configurado en Nginx Proxy Manager.
# ============================================================
FRONTEND_URL=http://localhost:5573
CORS_ORIGINS=http://localhost:5573

# ============================================================
# URL pública de la aplicación (para enlaces al QR)
# ============================================================
APP_URL=https://dominio.com

# ============================================================
# Resend (https://resend.com) -> API Keys
# El dominio de EMAIL_FROM debe estar verificado en Resend.
# Si RESEND_API_KEY queda vacía, los envíos se simulan (solo log).
# EMAIL_RATE_PER_SEC: envíos por segundo (Resend limita a 10 por equipo).
# ============================================================
RESEND_API_KEY=
EMAIL_FROM=no-reply@dominio.com
# Nombre visible del remitente. Que sea la marca del evento y en el idioma del
# correo: un nombre genérico en inglés desentona con el contenido y puntúa peor
# en los filtros de spam.
EMAIL_FROM_NAME=Ciudad Maderas Bootcamp
EMAIL_RATE_PER_SEC=8

# ============================================================
# Redis (cola de envío de correos con BullMQ)
# Nombre de servicio Docker (dev y prod corren su propio contenedor Redis).
# EMAIL_QUEUE_CONCURRENCY: jobs que el worker procesa en paralelo; el ritmo
# real de salida hacia Resend lo sigue limitando EMAIL_RATE_PER_SEC arriba.
# ============================================================
REDIS_URL=redis://redis:6379
EMAIL_QUEUE_CONCURRENCY=5

# ============================================================
# Generación de PDFs (Puppeteer-core + Chromium del sistema)
# Chromium se instala en la imagen con `apk add chromium` (Dockerfile). La ruta
# al binario debe coincidir con la que el paquete de Alpine provee.
# PDF_ALLOWED_RESOURCE_HOSTS: hosts (coma separados) a los que el PDF puede
# cargar subrecursos (imágenes, CSS, fuentes). Bloquea SSRF: solo se permite
# https y estos hosts. Incluye tu CDN y las fuentes de Google.
# PDF_CHROMIUM_NO_SANDBOX: último recurso si el contenedor no tiene la
# capability SYS_ADMIN (lo normal es usar cap_add: SYS_ADMIN en compose).
# ============================================================
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PDF_ALLOWED_RESOURCE_HOSTS=s3lata.maderasstudio.com,fonts.googleapis.com,fonts.gstatic.com
PDF_GENERATION_TIMEOUT_MS=30000
PDF_FAIL_ON_MISSING_IMAGE=false
PDF_MAX_ATTACHMENT_MB=25
PDF_CHROMIUM_NO_SANDBOX=false
PDF_VIEWPORT_WIDTH=1240
PDF_VIEWPORT_DEVICE_SCALE_FACTOR=2

# ============================================================
# Producción (docker-compose.prod.yml)
# Nombre de la red Docker donde corre Nginx Proxy Manager.
# Ver con: docker network ls
# ============================================================
NPM_NETWORK=proxy